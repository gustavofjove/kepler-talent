APP_ENV=local
APP_VERSION=0.1.0
API_BASE_URL=/api
ENTRA_CLIENT_ID=
ENTRA_AUTHORITY=
ENTRA_API_SCOPE=
FRONTEND_PORT=4200
KTL_MIGRATOR_PASSWORD=development-migrator-only
POSTGRES_PORT=5432
KTL_BACKUP_ROOT=./backups
KTL_BACKUP_RETENTION_DAYS=30
# KTL-33: path to the field encryption key file. A path, never the keys themselves.
KTL_FIELD_KEYS_FILE=./secrets/field-keys.json
# KTL-45: local Compose seeds rrhh_admin and rrhh_user with development-only passwords from
# docker-compose.yml, so nothing is needed here. The LAN server's overlay instead requires these
# three in /opt/apps/ktl-secrets/ktl.env (see docs/deploy-lan-server.md). Never commit values.
# KTL_AUTH_SIGNING_KEY=
# KTL_RRHH_ADMIN_PASSWORD=
# KTL_RRHH_USER_PASSWORD=
